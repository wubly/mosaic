<component type="desktop-application">
  <id>app.mosaic.player</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Mosaic</name>
  <summary>SoundCloud and your own music in one player</summary>
  <description>
    <p>Mosaic is a music player that puts SoundCloud and the files on your computer side by side. It has synced, word-by-word lyrics, crossfade, an equalizer, playlists and listening stats, and it takes its colours from the artwork of the song that is playing.</p>
    <p>Optional beta features add Spotify browsing, playlist import and (with Premium) Spotify playback.</p>
  </description>
  <launchable type="desktop-id">app.mosaic.player.desktop</launchable>
  <provides>
    <binary>mosaic</binary>
  </provides>
